{
  "name": "@plms/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "seed:demo": "npm run build && node dist/scripts/seed-demo-courses.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.0",
    "mongoose": "8.19.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
